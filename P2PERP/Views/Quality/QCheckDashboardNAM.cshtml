
@{
    ViewBag.Title = "QCheckDashboardNAM";
}




<style>
    /* Local Overrides & Enhancements */
    /* ===== Premium Global Harmonization Styles (Aligned with Inventory) ===== */
    :root {
        --theme-purple: #8b5cf6;
        --theme-purple-light: #f3f0ff;
        --theme-dark: #1f2937;
        --theme-green: #10b981;
        --theme-red: #ef4444;
        --theme-amber: #f59e0b;
        --border-radius-sm: 8px;
        --border-radius-lg: 12px;
    }

    /* 1. Global Table Headers */
    table thead th,
    .dataTable thead th,
    .table thead th,
    table.dataTable thead th,
    #confirmTable thead th,
    #PendingTable thead th,
    #NonconfirmTable thead th,
    #chartDataTable thead th {
        background-color: #1f2937 !important;
        background-image: none !important;
        color: white !important;
        text-transform: uppercase !important;
        font-size: 0.75rem !important;
        font-weight: 700 !important;
        letter-spacing: 0.5px;
        padding: 10px 10px !important;
        border: 1px solid #374151 !important;
        text-align: center !important;
        vertical-align: middle !important;
    }

    /* 2. Global Table Body */
    table tbody td,
    .dataTable tbody td {
        padding: 12px 10px !important;
        border-bottom: 1px solid #f3f4f6 !important;
        border-right: 1px solid #f3f4f6 !important;
        color: #374151;
        font-size: 0.85rem;
        vertical-align: middle !important;
    }

    table tbody tr:hover {
        background-color: #f9fafb !important;
    }

    /* 3. Export Button Squares */
    .dt-buttons .btn,
    .dt-button {
        background: #f3f4f6 !important;
        border: 1px solid #e5e7eb !important;
        border-radius: 10px !important;
        width: 38px !important;
        height: 38px !important;
        margin-right: 8px !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        box-shadow: none !important;
        transition: all 0.2s;
    }

    .dt-button:hover {
        background: #e5e7eb !important;
        transform: scale(1.05);
    }

    /* 4. Professional Search Bar */
    .dataTables_filter input {
        border: 1px solid #d1d5db !important;
        border-radius: 20px !important;
        padding: 6px 15px !important;
        width: 200px !important;
        outline: none;
        transition: all 0.3s;
        font-size: 0.85rem;
    }

    .dataTables_filter input:focus {
        border-color: var(--theme-purple) !important;
        box-shadow: 0 0 0 2px var(--theme-purple-light);
    }

    /* 5. Pagination Styling - Circle Match */
    .dataTables_paginate .paginate_button {
        background: #f0f0f0 !important;
        border-radius: 50% !important;
        width: 32px !important;
        height: 32px !important;
        line-height: 32px !important;
        padding: 0 !important;
        margin: 0 4px !important;
        border: none !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        color: #4a5568 !important;
        font-weight: 500 !important;
        transition: all 0.2s;
        cursor: pointer !important;
    }

    .dataTables_paginate .paginate_button.current {
        background: var(--theme-purple) !important;
        color: white !important;
        box-shadow: 0 4px 10px rgba(139, 92, 246, 0.3);
    }

    .dataTables_paginate .paginate_button:hover:not(.current) {
        background: #e2e8f0 !important;
    }

    /* 6. Premium Modal Styling */
    .modal-content {
        border-radius: 20px !important;
        border: none !important;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .modal-header {
        padding: 12px 25px !important;
        border-bottom: none !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        position: relative;
    }

    .modal-title {
        color: white !important;
        font-weight: 600 !important;
        font-size: 1.15rem;
        letter-spacing: 0.5px;
        text-align: center;
        flex-grow: 1;
    }

    .btn-close-custom {
        position: absolute;
        right: 15px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        color: white;
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-close-custom:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    /* Status-Specific Header Backgrounds */
    .bg-success-premium { background: var(--theme-green) !important; }
    .bg-danger-premium { background: var(--theme-red) !important; }
    .bg-warning-premium { background: var(--theme-amber) !important; color: white !important; }
    .bg-primary-premium { background: var(--theme-purple) !important; }

</style>

<div class="container-fluid py-4">
    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div class="header-title">
            <h4 class="mb-0">Quality Check Dashboard</h4>
            <p class="text-secondary small mb-0">Overview of item inspection status</p>
        </div>
        <div class="header-actions">
            <button id="calendarTrigger" class="calendar-trigger-btn" title="Filter by Date">
                <i class="bi bi-calendar-date fs-5"></i>
            </button>
            <input type="text" id="reportrange" style="width: 1px; height: 1px; opacity: 0; position: absolute;" />
        </div>
    </div>

    <!-- Stat Cards Grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="dashboard-card card-warning cursor-pointer" onclick="loadPendingList()">
                <div class="card-icon-wrapper">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="card-value" id="pending">0</div>
                    <div class="card-label">Pending Units</div>
                </div>
                <i class="bi bi-hourglass-split card-bg-icon"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-success cursor-pointer" onclick="loadConfirmList()">
                <div class="card-icon-wrapper">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="card-value" id="confirm">0</div>
                    <div class="card-label">Approved Quality</div>
                </div>
                <i class="bi bi-check-circle card-bg-icon"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-danger cursor-pointer" onclick="loadNonConfirmList()">
                <div class="card-icon-wrapper">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <div class="card-value" id="nonconfirm">0</div>
                    <div class="card-label">Rejected Quality</div>
                </div>
                <i class="bi bi-x-circle card-bg-icon"></i>
            </div>
        </div>

        <div class="col-md-3">
            <div class="dashboard-card card-primary">
                <div class="card-icon-wrapper">
                    <i class="bi bi-bar-chart-line"></i>
                </div>
                <div>
                    <div class="card-value" id="totalqc">0</div>
                    <div class="card-label">Total QC Items</div>
                </div>
                <i class="bi bi-bar-chart-line card-bg-icon"></i>
            </div>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="row">
        <div class="col-12">
            <div class="chart-panel">
                <div class="chart-header">
                    <div class="chart-title">
                        <i class="bi bi-pie-chart-fill text-primary"></i>
                        <span>Inspection Distribution</span>
                    </div>
                </div>
                <div id="doughnutChart" style="height: 350px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Only one toast container -->
<div id="toastContainer" class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 2000;"></div>



<!-- Unified Modal (Aligned with Inventory) -->
<div class="modal fade" id="chartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div id="modalHeader" class="modal-header">
                <h5 id="modalTitle" class="modal-title">Details</h5>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table id="chartDataTable" class="table w-100">
                        <!-- Table structure will be dynamic or updated via JS -->
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>




<script>

    let startDateGlobal = null;
    let endDateGlobal = null;
    $(document).ready(function () {
        $.fn.dataTable.ext.errMode = 'none';
        loadDashboardData(); // initial load
        initDateRangePicker();

        // Open datepicker on calendar button click
        $('#calendarTrigger').on('click', function () {
            $('#reportrange').data('daterangepicker').show();
        });
    });

    // Toast Notification
    function showToast(message, type = 'warning') {
        // Map to Bootstrap contextual colors
        let icon = '';
        let progressColor = '';

        switch (type) {
            case 'success':
                icon = '<i class="bi bi-check-circle-fill me-2"></i>';
                progressColor = 'bg-light';
                break;
            case 'warning':
                icon = '<i class="bi bi-exclamation-triangle-fill me-2"></i>';
                progressColor = 'bg-dark';
                break;
            case 'info':
                icon = '<i class="bi bi-info-circle-fill me-2"></i>';
                progressColor = 'bg-light';
                break;
            default: // error
                icon = '<i class="bi bi-x-circle-fill me-2"></i>';
                progressColor = 'bg-light';
        }

        const toastId = `toast-${Date.now()}`;

        // ✅ Toast HTML with white text for all
        const toastHTML = `
<div id="${toastId}" class="toast align-items-center bg-${type} border-0 mb-2 shadow-lg"
                                 role="alert" aria-live="assertive" aria-atomic="true"
                                 data-bs-delay="3000" data-bs-animation="true">
                                <div class="d-flex">
                                    <div class="toast-body d-flex align-items-center text-white">
                                        ${icon} ${message}
                                    </div>
                                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                                            data-bs-dismiss="toast" aria-label="Close"></button>
                                </div>
                                <div class="progress" style="height: 3px; margin:0; background: rgba(255,255,255,0.3);">
                            <div class="progress-bar" role="progressbar"></div>
</div>

</div>`;

        const $toast = $(toastHTML);
        $('#toastContainer').prepend($toast); // newestOnTop

        // ✅ Initialize bootstrap toast
        const toast = new bootstrap.Toast($toast[0], { delay: 3000 });
        toast.show();

        // ✅ Animate progress bar
        $toast.find('.progress-bar')
            .css({
                width: "100%",
                float: "right",
                backgroundColor: "black"
            })
            .animate(
                { width: "0%" },
                { duration: 3000, easing: "linear" }
            );



        // ✅ Auto-remove
        $toast.on('hidden.bs.toast', function () {
            $(this).remove();
        });
    }


    // === Dashboard Data ===
    function loadDashboardData(startDate = null, endDate = null) {
        let requestData = {};
        if (startDate && endDate) {
            requestData = { startDate: startDate, endDate: endDate };
        }

        $.ajax({
            url: '/Quality/GetConfirmCountNAM',
            type: 'GET',
            data: requestData,
            success: function (data) {
                if (data) {
                    // Show individual counts
                    $('#confirm').text(data.ConfirmCount);
                    $('#nonconfirm').text(data.NonConfirmCount);
                    $('#pending').text(data.PendingCount); // ✅ Pending dikhega

                    // ✅ Total QC = ONLY Confirm + Non-Confirm
                    const totalQC =
                        (data.ConfirmCount || 0) +
                        (data.NonConfirmCount || 0);

                    $('#totalqc').text(totalQC);

                    // Chart (agar pending dikhana hai to rehne do)
                    renderDoughnutChart(
                        data.ConfirmCount,
                        data.NonConfirmCount,
                        data.PendingCount
                    );
                }
            }
        });
    }




    function renderDoughnutChart(c, n, p) {
        Highcharts.chart('doughnutChart', {
            chart: {
                type: 'bar',
                backgroundColor: 'transparent',
                height: 350,
                spacing: [20, 20, 20, 20],
                style: {
                    fontFamily: "'Inter', sans-serif"
                }
            },
            title: {
                text: null // Title already in chart-header
            },
            xAxis: {
                categories: ['Approved Quality', 'Rejected Quality', 'Pending Units'],
                title: { text: null },
                gridLineWidth: 0,
                lineWidth: 0,
                labels: {
                    style: {
                        fontSize: '14px',
                        fontWeight: '600',
                        color: '#64748b'
                    }
                }
            },
            yAxis: {
                min: 0,
                title: {
                    text: 'Quantity of Items',
                    style: { color: '#94a3b8' }
                },
                labels: {
                    style: { color: '#94a3b8' }
                },
                gridLineColor: '#f1f5f9',
                gridLineDashStyle: 'Dash'
            },
            tooltip: {
                backgroundColor: '#ffffff',
                borderWidth: 0,
                borderRadius: 12,
                shadow: true,
                useHTML: true,
                headerFormat: '<span style="font-size: 11px; color: #94a3b8">{point.key}</span><br/>',
                pointFormat: '<span style="color:{point.color}">\u25CF</span> <b>{point.y}</b> items',
                padding: 12
            },
            plotOptions: {
                bar: {
                    borderRadius: 10,
                    pointWidth: 35,
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '{y}',
                        style: {
                            fontSize: '13px',
                            fontWeight: '700',
                            color: '#1e293b',
                            textOutline: 'none'
                        }
                    },
                    cursor: 'pointer',
                    point: {
                        events: {
                            click: function () {
                                if (this.category === 'Approved Quality')
                                    loadConfirmList();
                                else if (this.category === 'Rejected Quality')
                                    loadNonConfirmList();
                                else if (this.category === 'Pending Units')
                                    loadPendingList();
                            }
                        }
                    }
                }
            },
            legend: { enabled: false },
            credits: { enabled: false },
            series: [{
                name: 'Status',
                colorByPoint: true,
                data: [
                    { name: 'Approved Quality', y: c, color: '#10b981' }, // Success Emerald
                    { name: 'Rejected Quality', y: n, color: '#ef4444' }, // Danger Rose
                    { name: 'Pending Units', y: p, color: '#f59e0b' }    // Warning Amber
                ]
            }]
        });
    }




    // Unified Modal Open Logic
    function openStatusModal(type) {
        let title = "";
        let headerClass = "";
        let url = "";
        let columns = [];

        // Define Header Checkbox HTML
        const headerCheckbox = (id) => `<input type="checkbox" id="${id}" class="form-check-input" />`;

        switch (type) {
            case 'pending':
                title = "Pending Inspection List";
                headerClass = "bg-warning-premium";
                url = "/Quality/GetPendingListNAM";
                columns = [
                    { title: headerCheckbox('selectAllRows'), data: 'QualityCheckCode', className: 'text-center', render: (d) => `<input type="checkbox" class="row-select" value="${d}" />` },
                    { title: "Sr.No", data: null, className: 'text-center', render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { title: "QC Code", data: 'QualityCheckCode', className: 'text-center' },
                    { title: "Item Name", data: 'ItemName' },
                    { title: "Quantity", data: 'Quantity', className: 'text-center' },
                    { title: "Added By", data: 'AddedBy', className: 'text-center' },
                    { title: "Added Date", data: 'AddedDate', className: 'text-center', render: (d) => moment(d).format('DD/MM/YYYY') }
                ];
                break;
            case 'confirm':
                title = "Approved Quality List";
                headerClass = "bg-success-premium";
                url = "/Quality/GetConfirmedListNAM";
                columns = [
                    { title: headerCheckbox('selectAllRows'), data: 'QualityCheckCode', className: 'text-center', render: (d) => `<input type="checkbox" class="row-select" value="${d}" />` },
                    { title: "Sr.No", data: null, className: 'text-center', render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { title: "QC Code", data: 'QualityCheckCode', className: 'text-center' },
                    { title: "Item Name", data: 'ItemName' },
                    { title: "Quantity", data: 'Quantity', className: 'text-center' },
                    { title: "Added By", data: 'AddedBy', className: 'text-center' },
                    { title: "Added Date", data: 'AddedDate', className: 'text-center', render: (d) => moment(d).format('DD/MM/YYYY') }
                ];
                break;
            case 'nonconfirm':
                title = "Rejected Quality List";
                headerClass = "bg-danger-premium";
                url = "/Quality/GetNonConfirmedListNAM";
                columns = [
                    { title: headerCheckbox('selectAllRows'), data: 'QualityCheckCode', className: 'text-center', render: (d) => `<input type="checkbox" class="row-select" value="${d}" />` },
                    { title: "Sr.No", data: null, className: 'text-center', render: (d, t, r, meta) => meta.row + meta.settings._iDisplayStart + 1 },
                    { title: "QC Code", data: 'QualityCheckCode', className: 'text-center' },
                    { title: "Item Name", data: 'ItemName' },
                    { title: "Quantity", data: 'Quantity', className: 'text-center' },
                    { title: "Added By", data: 'AddedBy', className: 'text-center' },
                    { title: "Reason", data: 'Reason', className: 'text-center', render: (d) => d || '' },
                    { title: "Added Date", data: 'AddedDate', className: 'text-center', render: (d) => moment(d).format('DD/MM/YYYY') }
                ];
                break;
        }

        // Apply UI Updates
        $("#modalTitle").text(title);
        $("#modalHeader").removeClass("bg-success-premium bg-danger-premium bg-warning-premium").addClass(headerClass);

        // Clear existing DataTable if any
        if ($.fn.DataTable.isDataTable('#chartDataTable')) {
            $('#chartDataTable').DataTable().destroy();
            $('#chartDataTable').empty();
        }

        // Show Modal
        let modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('chartModal'));
        modal.show();

        // Load Data and Init DataTable
        let requestData = { startDate: startDateGlobal, endDate: endDateGlobal };

        $('#chartDataTable').DataTable({
            ajax: {
                url: url,
                data: requestData,
                dataSrc: ""
            },
            columns: columns,
            dom: '<"table-controls"<"dt-buttons"B><"dt-search"f>>rt<"bottom d-flex justify-content-between align-items-center"ip>>',
            ordering: false,
            buttons: [
                {
                    extend: 'print',
                    text: '<i class="bi bi-printer text-dark fs-5"></i>',
                    titleAttr: 'Print',
                    exportOptions: { columns: ':visible:not(:first-child)' }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="bi bi-file-earmark-pdf text-danger fs-5"></i>',
                    titleAttr: 'PDF',
                    exportOptions: { columns: ':visible:not(:first-child)' }
                },
                {
                    extend: 'excelHtml5',
                    text: '<i class="bi bi-file-earmark-excel text-success fs-5"></i>',
                    titleAttr: 'Excel',
                    exportOptions: { columns: ':visible:not(:first-child)' }
                }
            ],
            initComplete: function() {
                // Select All logic
                $('#selectAllRows').on('click', function() {
                    $('.row-select').prop('checked', this.checked);
                });
            }
        });
    }

    // Legacy function wrappers for compatibility with existing onclicks
    function loadPendingList() { openStatusModal('pending'); }
    function loadConfirmList() { openStatusModal('confirm'); }
    function loadNonConfirmList() { openStatusModal('nonconfirm'); }


    function initDateRangePicker() {
        var start = moment().subtract(29, 'days');
        var end = moment();
        function cb(start, end) {
            $('#reportrange').val(start.format('YYYY-MM-DD') + ' - ' + end.format('YYYY-MM-DD'));
            startDateGlobal = start.format("YYYY-MM-DD");
            endDateGlobal = end.format("YYYY-MM-DD");
            loadDashboardData(start.format("YYYY-MM-DD"), end.format("YYYY-MM-DD"));





        }
        $('#reportrange').daterangepicker({
            startDate: start, endDate: end, autoUpdateInput: false,
            ranges: {
                'Today': [moment(), moment()],
                'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                'Last 1 Month': [moment().subtract(1, 'month'), moment()],
                'Last 3 Months': [moment().subtract(3, 'month'), moment()],
                'Last 1 Year': [moment().subtract(1, 'year'), moment()]
            },
            locale: { cancelLabel: 'Clear' }
        }, cb);

        $('#reportrange').on('cancel.daterangepicker', function () {
            $(this).val('');
            loadDashboardData();
            startDateGlobal = null;
            endDateGlobal = null;

        });
    }


</script>

